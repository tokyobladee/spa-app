{
  "name": "comments-spa",
  "version": "0.1.0",
  "private": true,
  "description": "Production comments SPA with threaded replies, attachments, realtime updates, and scalable backend architecture.",
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -r --parallel dev",
    "lint": "eslint .",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @comments/api test:e2e",
    "typecheck": "pnpm -r typecheck",
    "load:test": "k6 run tests/load/comments.js",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@types/node": "^22.14.0",
    "eslint": "^9.34.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.42.0"
  }
}
